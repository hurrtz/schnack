{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "app/_layout.tsx",
    "app/index.tsx",
    "app/store-promos.tsx",
    "plugins/*.js",
    "scripts/*.{mjs,ts}"
  ],
  "project": [
    "app/**/*.{ts,tsx}",
    "src/**/*.{ts,tsx}",
    "__tests__/**/*.{ts,tsx}",
    "__mocks__/**/*.{js,ts}",
    "data/**/*.ts",
    "plugins/*.js",
    "scripts/*.{mjs,ts}"
  ],
  "ignore": [
    "android/**",
    "ios/**",
    "artifacts/**",
    "coverage/**"
  ],
  "ignoreDependencies": ["react-native-web", "react-dom"]
}
